# Spring (backend/) — exportar no shell ou tool de deploy
# Profile local: SPRING_PROFILES_ACTIVE=local  ou  -Dspring-boot.run.profiles=local

# --- Servidor / token ---
PORT=8080
LMS_API_TOKEN=
LMS_JWT_SECRET=
LMS_JWT_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000

# --- Auth / seed / rate limit ---
LMS_BLOCK_DEMO_SEED_LOGINS=
LMS_JIT_PROVISIONING=
LMS_JIT_DEFAULT_UNIT=matriz
LMS_ALLOWED_EMAIL_DOMAINS=
LMS_BOOTSTRAP_ADMIN_EMAILS=
LMS_LOGIN_RATE_LIMIT_ENABLED=
LMS_LOGIN_RATE_LIMIT_MAX=
LMS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# Mutações /api/v1 + GET /users/me/export (Caffeine; single-instance). local default off.
LMS_API_RATE_LIMIT_ENABLED=
LMS_API_RATE_LIMIT_MAX=60
LMS_API_RATE_LIMIT_WINDOW_SECONDS=60
LMS_SEED_ENABLED=
LMS_SEED_PASSWORD=

# --- DB (profile prod / Postgres) ---
# Nome real em application.yml (não DATABASE_URL)
JDBC_DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Object storage (MP4) — S3-compatible ---
# Sem LMS_S3_ENABLED=true o endpoint POST /api/v1/media/videos responde 503
LMS_S3_ENABLED=false
LMS_S3_ENDPOINT=
LMS_S3_REGION=us-east-1
LMS_S3_BUCKET=
LMS_S3_ACCESS_KEY=
LMS_S3_SECRET_KEY=
# URL pública/CDN (sem barra final). Se vazio, usa URL signed GET
LMS_S3_PUBLIC_BASE_URL=
LMS_S3_MAX_FILE_BYTES=104857600
LMS_S3_PRESIGN_TTL_SECONDS=3600
LMS_S3_MAX_REQUEST_BYTES=110100480
# Hosts allowlist para videoUrl (CSV, match exato). Vazio = qualquer http(s).
# Ex.: cdn.example.com,my-bucket.s3.us-east-1.amazonaws.com
LMS_VIDEO_URL_ALLOWED_HOSTS=

# --- LGPD retention purge ---
# local: off; prod profile default on. Cron 03:30 UTC.
LMS_RETENTION_ENABLED=
LMS_RETENTION_PROGRESS_MONTHS=24
LMS_RETENTION_ACCESS_LOG_MONTHS=12

# --- Certificados ---
LMS_CERTIFICATE_VALIDITY_MONTHS=24
LMS_CERTIFICATE_VERIFY_BASE_URL=http://localhost:3000/certificados/verificar
